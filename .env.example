# Every value is optional. With none set, `npm run judge` and the web app still
# run: the fixed rules answer and the pages read the public testnet contract.

NEAR_NETWORK=testnet
PAUSE_CONTRACT=pause.pause-demo.testnet

# The agent. This must be a function-call key limited to set_risk and
# extend_hold on the Pause contract. A full-access key is refused.
AGENT_ACCOUNT=agent.pause-demo.testnet
AGENT_PRIVATE_KEY=

# NEAR AI Cloud (https://cloud.near.ai). Use a model hosted inside a TEE.
NEARAI_API_KEY=
NEARAI_MODEL=Qwen/Qwen3.6-35B-A3B-FP8

# Guest accounts for /demo: a funded testnet account that creates and funds
# two sub-accounts per judge (about 0.55 NEAR each time).
GUEST_SPONSOR_ACCOUNT=
GUEST_SPONSOR_KEY=

# Telegram agent, from @BotFather.
TELEGRAM_BOT_TOKEN=
PAUSE_WEB_URL=http://localhost:3000

# Public URL of the web app, used for link previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pause Groups (scripts/setup-groups.sh fills these)
POT_AGENT_ACCOUNT=treasurer.pause-demo.testnet
POT_AGENT_KEY=
GROUP_KEY_ADA=
GROUP_KEY_TUNDE=
GROUP_KEY_MUSA=
GROUP_KEY_CHI=
VENDOR_KEY_HALL=
VENDOR_KEY_MAMA=
VENDOR_KEY_DRINKS=

# Public URL of the Telegram agent's endpoint (Railway)
NEXT_PUBLIC_BOT_URL=
SERPER_API_KEY=
